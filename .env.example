# ============================================================
# Camino UTP - variables de entorno
# Copia este archivo como .env antes de conectar Supabase.
# NUNCA subas .env ni claves reales al repositorio.
# ============================================================

# --- Supabase (Etapa 3) -------------------------------------
# Project URL, disponible en Supabase > Project Settings > API
VITE_SUPABASE_URL=
# Clave publica (publishable). Es segura para el navegador SOLO
# porque las politicas RLS protegen los datos.
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Aplicacion ---------------------------------------------
VITE_APP_NAME=Camino UTP
# Correo de soporte mostrado en el centro de ayuda
VITE_SUPPORT_EMAIL=soporte.camino@utp.edu.pe
